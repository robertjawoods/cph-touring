---
import background from '../assets/background.svg';
---

<div class="hero">
	<img class="background" src={background.src} alt="" />
	<div class="content">
		<h1>CPH Music Touring</h1>
		<p>Your premier partner for seamless music tour logistics and management</p>
		<div class="cta-buttons">
			<a href="/booking" class="btn primary">Book Your Tour</a>
			<a href="/about" class="btn secondary">Learn More</a>
		</div>
	</div>
</div>

<style>
	.hero {
		position: relative;
		height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background: #ffffff;
	}

	.background {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -1;
		filter: blur(2px) brightness(0.3);
	}

	.content {
		text-align: center;
		max-width: 800px;
		padding: 2rem;
		z-index: 1;
	}

	h1 {
		font-size: 4rem;
		font-weight: bold;
		margin-bottom: 1rem;
		color: #212529;
		text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
	}

	p {
		font-size: 1.5rem;
		margin-bottom: 2rem;
		color: #6c757d;
		line-height: 1.6;
	}

	.cta-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-block;
		padding: 1rem 2rem;
		text-decoration: none;
		border-radius: 50px;
		font-weight: 600;
		transition: all 0.3s ease;
		font-size: 1.1rem;
	}

	.btn.primary {
		background: linear-gradient(135deg, #ff6b6b, #ee5a24);
		color: white;
		box-shadow: 0 4px 15px rgba(255, 107, 107, 0.3);
	}

	.btn.primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(255, 107, 107, 0.4);
	}

	.btn.secondary {
		background: transparent;
		color: #212529;
		border: 2px solid #212529;
	}

	.btn.secondary:hover {
		background: #212529;
		color: #ffffff;
	}

	@media (max-width: 768px) {
		h1 {
			font-size: 2.5rem;
		}

		p {
			font-size: 1.2rem;
		}

		.cta-buttons {
			flex-direction: column;
			align-items: center;
		}

		.btn {
			width: 200px;
		}
	}
</style>
